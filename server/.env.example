APP_ENV=development
FLASK_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=bragright
SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=bragright_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PARTITIONED=false
INIT_DB_INDEXES_AT_STARTUP=false
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=5
MAX_JSON_BODY_SIZE_KB=256
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=app/uploads
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=750
RESPONSE_COMPRESSION_MIN_BYTES=1024
PUBLIC_CACHE_MAX_AGE_SECONDS=15
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_MATCH_MUTATION=30
RATE_LIMIT_ADMIN_RESET=10
TRUST_PROXY=false
MATCH_DUPLICATE_WINDOW_MINUTES=4
ADMIN_EMAILS=admin@example.com
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_USERNAME=bragright-admin
ADMIN_SEED_PASSWORD=replace-with-a-strong-one-time-password
ADMIN_SEED_ROLE=admin
# Monthly subscription values are stored centrally in minor currency units.
SUBSCRIPTION_MONTHLY_FEE_MINOR=2000
SUBSCRIPTION_CURRENCY=GHS
SUBSCRIPTION_GRACE_DAYS=7
PAYMENT_REQUIRES_SUPER_ADMIN_VERIFICATION=false
SUBSCRIPTION_PAYMENT_INSTRUCTIONS=Pay the monthly fee, keep the transaction reference, and submit it for verification or contact BragPay.
SUBSCRIPTION_PAYMENT_DESTINATION=Contact BragPay for the current payment destination.
SUBSCRIPTION_SUPPORT_CONTACT=Contact BragRight support or an administrator.
